<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkGrid" id="color_system_grid">
    <property name="orientation">vertical</property>
    <property name="row-spacing">4</property>
    <property name="column-spacing">4</property>
    <child>
      <object class="GtkLabel" id="linked_label">
        <property name="halign">start</property>
        <property name="label" translatable="yes">Linked Color Profiles</property>
        <property name="use-markup">True</property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="linked_scroller">
        <property name="has-frame">True</property>
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">always</property>
        <property name="width-request">-1</property>
        <property name="height-request">90</property>
        <child>
          <object class="GtkTreeView" id="linked_view">
            <property name="headers-visible">False</property>
          </object>
        </child>
        <layout>
          <property name="column">0</property>
          <property name="row">1</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="available_label">
        <property name="halign">start</property>
        <property name="label" translatable="yes">Available Color Profiles</property>
        <layout>
          <property name="column">0</property>
          <property name="row">2</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkComboBox" id="avail_combo">
        <property name="hexpand">True</property>
        <layout>
          <property name="column">0</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="unlink_btn">
        <property name="has-frame">True</property>
        <property name="tooltip-text" translatable="yes">Unlink Profile</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">list-remove</property>
          </object>
        </child>
        <layout>
          <property name="column">1</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
