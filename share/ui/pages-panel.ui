<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <placeholder width="281" height="356"></placeholder>
  <requires lib="gtk" version="4.0"></requires>
  <object class="GtkGrid" id="pages_grid">
    <property name="valign">start</property>
    <property name="orientation">vertical</property>
    <property name="row-spacing">4</property>
    <property name="column-spacing">4</property>
    <child>
      <object class="GtkLabel">
        <property name="halign">start</property>
        <property name="label" translatable="yes">Pages</property>
        <style>
          <class name="heading"></class>
        </style>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="column-span">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="add_page_btn">
        <property name="label" translatable="yes">Add Page</property>
        <property name="tooltip-text" translatable="yes">Add a new page to the document</property>
        <layout>
          <property name="column">0</property>
          <property name="row">1</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="delete_page_btn">
        <property name="label" translatable="yes">Delete Page</property>
        <property name="tooltip-text" translatable="yes">Delete the current page</property>
        <layout>
          <property name="column">2</property>
          <property name="row">1</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="move_page_up_btn">
        <property name="visible">false</property>
        <property name="label" translatable="yes">Move Up</property>
        <property name="tooltip-text" translatable="yes">Move the current page up in the page order</property>
        <layout>
          <property name="column">0</property>
          <property name="row">2</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="move_page_down_btn">
        <property name="visible">false</property>
        <property name="label" translatable="yes">Move Down</property>
        <property name="tooltip-text" translatable="yes">Move the current page down in the page order</property>
        <layout>
          <property name="column">2</property>
          <property name="row">2</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel">
        <property name="visible">false</property>
        <property name="halign">start</property>
        <property name="label" translatable="yes">Display</property>
        <style>
          <class name="heading"></class>
        </style>
        <layout>
          <property name="column">0</property>
          <property name="row">3</property>
          <property name="column-span">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkCheckButton" id="show_page_border_btn">
        <property name="visible">false</property>
        <property name="label" translatable="yes">Show page border</property>
        <property name="tooltip-text" translatable="yes">Show or hide page borders</property>
        <layout>
          <property name="column">0</property>
          <property name="row">4</property>
          <property name="column-span">4</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkCheckButton" id="show_page_shadow_btn">
        <property name="visible">false</property>
        <property name="label" translatable="yes">Show page shadow</property>
        <property name="tooltip-text" translatable="yes">Show or drop shadow around pages</property>
        <layout>
          <property name="column">0</property>
          <property name="row">5</property>
          <property name="column-span">4</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkCheckButton" id="move-with-page">
        <property name="valign">fill</property>
        <property name="label" translatable="yes">Move objects with page</property>
        <property name="tooltip-text" translatable="yes">Show labels below pages in multi-page documents</property>
        <layout>
          <property name="column">2</property>
          <property name="row">6</property>
          <property name="column-span">3</property>
        </layout>
      </object>
    </child>
    <!--dim: 4, 7-->
  </object>
</interface>
